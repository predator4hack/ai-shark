# =============================================================================
# MULTI-LLM CONFIGURATION
# =============================================================================
# AI-Shark uses different LLMs for different tasks to optimize cost:
# - Vision tasks (Phase 1): Configurable between Gemini and Groq Llama 4
# - Text tasks (Phases 2-5): Groq Llama 4 Scout (cost-efficient)
# - Fallback: Groq Llama 4 Maverick (multimodal, reliable)

# Vision LLM Configuration (Phase 1 - Pitch Deck Processing)
# Options: "google" or "groq"
# - "google": Uses Gemini 2.5 Flash (proven, reliable)
# - "groq": Uses Llama 4 Maverick (cheaper, multimodal)
VISION_PROVIDER=google
VISION_MODEL_GOOGLE=gemini-2.5-flash
VISION_MODEL_GROQ=meta-llama/llama-4-maverick-17b-128e-instruct

# Text LLM Configuration (Phases 2-5 - Analysis, Q&A, Memo)
# Uses Llama 4 Scout on Groq for maximum cost savings
TEXT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Fallback Configuration
# When primary LLM fails, falls back to Llama 4 Maverick
ENABLE_LLM_FALLBACK=true
FALLBACK_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# =============================================================================
# API KEYS
# =============================================================================

# Groq API Key (REQUIRED for text tasks and optionally for vision)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (REQUIRED if VISION_PROVIDER=google)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# LEGACY CONFIGURATION (kept for backward compatibility)
# =============================================================================

# LLM Provider Selection (legacy - use VISION_PROVIDER and TEXT_MODEL instead)
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=100000
GROQ_RETRY_ATTEMPTS=3
GROQ_RETRY_DELAY=1.0

# Google Gemini API Configuration
GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.1
MAX_TOKENS=100000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY=1.0
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
# Application Configuration
APP_NAME=VC Document Analyzer
MAX_FILE_SIZE_MB=10
SUPPORTED_FORMATS=pdf,pptx,png,jpg,jpeg

# Output Configuration
OUTPUT_DIR=outputs

# FastAPI Backend Configuration
USE_GCS=false
GCS_BUCKET_NAME=ai-shark-outputs
API_HOST=0.0.0.0
API_PORT=8000
JOB_CLEANUP_HOURS=24

# =============================================================================
# FIRESTORE CONFIGURATION
# =============================================================================

# Enable Firestore database (set to 'true' to use Firestore instead of file-based storage)
USE_FIRESTORE=false

# GCP Project ID (required if USE_FIRESTORE=true)
GCP_PROJECT_ID=your-project-id

# Firestore credentials (for production)
# Option 1: Service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Application Default Credentials (ADC) - preferred for GCP environments
# No explicit config needed - uses gcloud auth or GCE metadata

# Firestore settings
FIRESTORE_DATABASE_ID=(default)  # Use "(default)" or custom database name

# Frontend Configuration (for CORS)
# For local development
FRONTEND_URL=http://localhost:3000
# For production (Vercel/Netlify), update with actual frontend URL:
# FRONTEND_URL=https://your-app.vercel.app

# Gemini Model Configuration (for FastAPI)
GEMINI_MODEL=gemini-2.5-flash

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Mock Mode Configuration (for testing without API calls)
# Set to 'true' to use mock LLM responses instead of real API calls
# This skips both LLM API calls AND file processing (PDF/PPT conversion)
# Useful for frontend development and testing without consuming API tokens
USE_MOCK_LLM=false

# Search APIs
BRAVE_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
SERP_API_KEY=your-api-key